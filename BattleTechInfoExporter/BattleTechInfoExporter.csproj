<Project Sdk="Microsoft.NET.Sdk" InitialTargets="ValidateBattleTechGameDir">
  <PropertyGroup>
    <!-- The game runs on Mono with the .NET Framework 4.7.2 profile; newer targets don't load. -->
    <TargetFramework>net472</TargetFramework>
    <!-- Framework and game assemblies resolve from the game's Managed folder only. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AssemblySearchPaths>{HintPathFromItem};$(BattleTechGameDir)\BattleTech_Data\Managed</AssemblySearchPaths>
    <DebugType>embedded</DebugType>
    <!-- Avoids IgnoresAccessChecksToAttribute warnings from the publicized game assembly. -->
    <PublicizerRuntimeStrategies>Unsafe</PublicizerRuntimeStrategies>
    <ModDirectoryInGame>$(BattleTechGameDir)\Mods\$(MSBuildProjectName)\</ModDirectoryInGame>
    <!-- The models' doc comments are the schemas' descriptions. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SchemaGeneratorProject>$(MSBuildThisFileDirectory)..\BattleTechInfoExporter.SchemaGenerator\BattleTechInfoExporter.SchemaGenerator.csproj</SchemaGeneratorProject>
    <!-- No trailing backslash, which would escape the closing quote of the generator's argument. -->
    <SchemaDirectory>$(MSBuildThisFileDirectory)..\schemas</SchemaDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HarmonyX" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Krafs.Publicizer" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads the serializer settings the files are written with. -->
    <InternalsVisibleTo Include="BattleTechInfoExporter.SchemaGenerator" />
  </ItemGroup>

  <!-- The game provides these at runtime; they're never copied into the mod. -->
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="Assembly-CSharp" />
    <Reference Include="Newtonsoft.Json" />
    <!-- Also ships the JetBrains annotations ([UsedImplicitly]) that tell ReSharper what only reflection uses. -->
    <Reference Include="UnityEngine.CoreModule" />
  </ItemGroup>

  <!-- Everything the mod folder needs; deployed to the game and packaged for releases. -->
  <ItemGroup>
    <ModFile Include="$(TargetPath);$(OutDir)mod.json" />
  </ItemGroup>

  <Target Name="ValidateBattleTechGameDir"
          Condition="'$(BattleTechGameDir)' == '' Or !Exists('$(BattleTechGameDir)\BattleTech_Data\Managed')">
    <Error Text="BattleTechGameDir must point to the BattleTech install; see README.md." />
  </Target>

  <!-- A target, because Version gets its build number only once ComputeBuildVersion has run. -->
  <Target Name="SetPackageFile" AfterTargets="ComputeBuildVersion">
    <PropertyGroup>
      <PackageFile>$(MSBuildThisFileDirectory)..\artifacts\$(MSBuildProjectName)-$(Version).zip</PackageFile>
    </PropertyGroup>
  </Target>

  <!--
    The schemas are generated from this build's models on every build, so schemas/ always matches them, before
    mod.json, the deployment and the zip, which ship them. Declared before WriteModJson, so they run first. The
    generator's build inherits this build's configuration and references the mod this build wrote.
  -->
  <Target Name="BuildSchemaGenerator" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- Without the solution's configuration, which turns the generator's build dependency on this project into a
         project reference, a circular one from here. -->
    <MSBuild Projects="$(SchemaGeneratorProject)" Targets="Build" Properties="ModAssemblyPath=$(TargetPath)"
             RemoveProperties="CurrentSolutionConfigurationContents">
      <Output TaskParameter="TargetOutputs" PropertyName="SchemaGeneratorPath" />
    </MSBuild>
  </Target>

  <Target Name="GenerateSchemas" AfterTargets="BuildSchemaGenerator" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(SchemaGeneratorPath)&quot; &quot;$(BattleTechGameDir)&quot; &quot;$(SchemaDirectory)&quot;" />
  </Target>

  <!-- In a target, so a new export file's schema ships with the build that generates it. -->
  <Target Name="AddSchemasToModFiles" AfterTargets="GenerateSchemas">
    <ItemGroup>
      <ModFile Include="$(SchemaDirectory)\*.schema.json" ModFolder="schemas\" />
    </ItemGroup>
  </Target>

  <!-- mod.json is generated so its metadata has a single source: the properties in Directory.Build.props. -->
  <Target Name="WriteModJson" AfterTargets="Build">
    <!-- Release only: a timestamp in every build would rewrite and redeploy mod.json each time. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
      <ModJsonPackagedOn>
  "PackagedOn": "$([System.DateTime]::UtcNow.ToString('o'))",</ModJsonPackagedOn>
    </PropertyGroup>
    <PropertyGroup>
      <ModJson>{
  "Name": "$(MSBuildProjectName)",
  "Enabled": true,
  "Version": "$(Version)",$(ModJsonPackagedOn)
  "Description": "$(Description)",
  "Author": "$(Authors)",
  "Website": "$(RepositoryUrl)",
  "BattleTechVersion": "$(BattleTechVersion)",
  "DLL": "$(TargetFileName)"
}</ModJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)mod.json" Lines="$(ModJson)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Opt-in, so a build in one worktree doesn't replace the mod the game is testing from another. -->
  <Target Name="DeployToGame" AfterTargets="WriteModJson" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="@(ModFile)" DestinationFiles="@(ModFile->'$(ModDirectoryInGame)%(ModFolder)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- The release zip extracts into the game's Mods folder. -->
  <Target Name="PackageMod" AfterTargets="WriteModJson" Condition="'$(Configuration)' == 'Release'"
          Inputs="@(ModFile)" Outputs="$(PackageFile)">
    <PropertyGroup>
      <PackageStagingDir>$(IntermediateOutputPath)package\</PackageStagingDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStagingDir)" />
    <Copy SourceFiles="@(ModFile)"
          DestinationFiles="@(ModFile->'$(PackageStagingDir)$(MSBuildProjectName)\%(ModFolder)%(Filename)%(Extension)')" />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(PackageFile)))" />
    <ZipDirectory SourceDirectory="$(PackageStagingDir)" DestinationFile="$(PackageFile)" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(PackageFile)" />
  </Target>
</Project>
