<Project Sdk="Microsoft.NET.Sdk" InitialTargets="ValidateBattleTechGameDir">
  <PropertyGroup>
    <!-- The game runs on Mono with the .NET Framework 4.7.2 profile; newer targets don't load. -->
    <TargetFramework>net472</TargetFramework>
    <!-- Framework and game assemblies resolve from the game's Managed folder only. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AssemblySearchPaths>{HintPathFromItem};$(BattleTechGameDir)\BattleTech_Data\Managed</AssemblySearchPaths>
    <DebugType>embedded</DebugType>
    <!-- Avoids IgnoresAccessChecksToAttribute warnings from the publicized game assembly. -->
    <PublicizerRuntimeStrategies>Unsafe</PublicizerRuntimeStrategies>
    <ModDirectoryInGame>$(BattleTechGameDir)\Mods\$(MSBuildProjectName)\</ModDirectoryInGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HarmonyX" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Krafs.Publicizer" PrivateAssets="all" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" Private="false" />
    <Reference Include="System.Core" Private="false" />
    <Reference Include="Assembly-CSharp" Private="false" />
  </ItemGroup>

  <Target Name="ValidateBattleTechGameDir"
          Condition="'$(BattleTechGameDir)' == '' Or !Exists('$(BattleTechGameDir)\BattleTech_Data\Managed')">
    <Error Text="BattleTechGameDir must point to the BattleTech install; see README.md." />
  </Target>

  <!-- mod.json is generated so the version has a single source: $(Version). -->
  <Target Name="WriteModJson" AfterTargets="Build">
    <PropertyGroup>
      <ModJson>{
  "Name": "$(MSBuildProjectName)",
  "Version": "$(Version)",
  "DLL": "$(TargetFileName)"
}</ModJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)mod.json" Lines="$(ModJson)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="DeployToGame" AfterTargets="WriteModJson">
    <Copy SourceFiles="$(TargetPath);$(OutDir)mod.json" DestinationFolder="$(ModDirectoryInGame)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The release zip extracts into the game's Mods folder. -->
  <Target Name="PackageMod" AfterTargets="WriteModJson" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageStagingDir>$(IntermediateOutputPath)package\</PackageStagingDir>
      <PackageDir>$(MSBuildThisFileDirectory)..\artifacts\</PackageDir>
      <PackageFile>$(PackageDir)$(MSBuildProjectName)-$(Version).zip</PackageFile>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStagingDir)" />
    <MakeDir Directories="$(PackageDir)" />
    <Copy SourceFiles="$(TargetPath);$(OutDir)mod.json" DestinationFolder="$(PackageStagingDir)$(MSBuildProjectName)\" />
    <ZipDirectory SourceDirectory="$(PackageStagingDir)" DestinationFile="$(PackageFile)" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(PackageFile)" />
  </Target>
</Project>
