<Project>
  <!-- Machine-specific settings, e.g. BattleTechGameDir; see README.md. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />

  <PropertyGroup>
    <Version>0.36.0</Version>
    <Description>Exports the story campaign's career state as JSON for tools to read.</Description>
    <Authors>Sephiroth018</Authors>
    <RepositoryUrl>https://github.com/Sephiroth018/BattleTechInfoExporter</RepositoryUrl>
    <BattleTechVersion>1.9.1</BattleTechVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
