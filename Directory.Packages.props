<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- The version ModTek ships and loads at runtime. -->
    <PackageVersion Include="HarmonyX" Version="2.16.0" />
    <PackageVersion Include="Krafs.Publicizer" Version="2.3.2" />
    <!-- Only the schema generator, which runs at build time; brings Newtonsoft.Json 13, which the game never loads. -->
    <PackageVersion Include="NJsonSchema.NewtonsoftJson" Version="11.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Polyfills for newer C# features on old target frameworks, in every project. -->
    <GlobalPackageReference Include="PolySharp" Version="1.16.0" />
  </ItemGroup>
</Project>
